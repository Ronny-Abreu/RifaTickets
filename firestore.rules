rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para el admin
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // solo puede crear su documento al registrarse (role forzado a 'client')
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'client';
    }

    // Reglas publicas
    match /rifas/{rifaId} {
      allow read: if true;

      match /boletos/{boletoId} {
        allow read: if true;
        allow create: if request.resource.data.estado == 'pendiente'
          && request.resource.data.compradorEmail is string
          && request.resource.data.compradorEmail.size() > 0
          && request.resource.data.voucherUrl is string
          && request.resource.data.voucherUrl.size() > 0;
      }
    }
  }
}
